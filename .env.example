# ===== Crisp =====
# Marketplace 插件的 token(identifier:key),或账号 token(此时 CRISP_TIER 改为 user)
CRISP_IDENTIFIER=
CRISP_KEY=
CRISP_TIER=plugin
# Crisp 后台 → 设置 → 网站设置 → 集成 里能看到 website_id
CRISP_WEBSITE_ID=
# Marketplace 插件 Web Hooks 页面的签名密钥(可选,留空则不校验签名)
CRISP_WEBHOOK_SECRET=

# ===== Telegram =====
TG_BOT_TOKEN=
# 话题群(supergroup)的 chat id,负数,形如 -1001234567890
TG_GROUP_ID=
# 低置信度时 @ 的用户名(不带 @),可留空
TG_ADMIN=

# ===== LLM(OpenAI 协议)=====
# 直连官方则留空;走 new-api 等中转则填中转域名,如 https://your-relay.com(SDK 会自动拼 /v1/chat/completions)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-5.5

# ===== 行为 =====
# AI 回答置信度低于该值时不直接回复访客,转人工
CONFIDENCE_THRESHOLD=0.65
# 人工接管后,距最后一条人工回复超过该分钟数则 AI 自动恢复;0 = 永不自动恢复
AI_RESUME_MINUTES=30
# 自动学习:每隔多少小时把人工回答提炼进知识库;积累多少条候选才启动一轮
LEARN_INTERVAL_HOURS=6
LEARN_MIN_CANDIDATES=3
# 人工回复后多少分钟自动触发一轮学习(防抖);0 = 关闭
LEARN_DEBOUNCE_MINUTES=5
# 访客连发消息合并:收到消息后等 N 秒再统一回答(降低 LLM 调用);0 = 立即逐条回答
ANSWER_DEBOUNCE_SECONDS=8
# 访客资料(meta)缓存秒数,期间不重复调 Crisp API
META_CACHE_SECONDS=300
# 客服人设风格: casual(口语化) / formal(正式官方)
PERSONA_STYLE=casual
# 本地对话文字保留小时数,过期自动删除(Crisp 云端有完整记录);0 = 永久保留
DATA_RETENTION_HOURS=24
# 低置信度时发给访客的兜底话术,留空则什么都不发(只在 TG 提醒人工)
LOW_CONF_REPLY=

# ===== 其他 =====
KB_DIR=./kb
DB_PATH=./data/bot.db
PORT=8300
